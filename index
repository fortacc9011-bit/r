<!-- ══ 🚀 Space + Falling Keys JS ══ -->
<script>
(function(){
  /* ── 1. Stars ── */
  const sl = document.getElementById('stars-layer');
  if(sl){
    const count = 180;
    for(let i=0;i<count;i++){
      const s = document.createElement('div');
      s.className = 'star';
      const size = Math.random()*2.2+.4;
      const bright = (Math.random()*.5+.2).toFixed(2);
      s.style.cssText = `
        width:${size}px;height:${size}px;
        left:${Math.random()*100}%;top:${Math.random()*100}%;
        --dur:${(Math.random()*4+2).toFixed(1)}s;
        --delay:${(Math.random()*5).toFixed(1)}s;
        --bright:${bright};
        box-shadow:0 0 ${size*2}px rgba(255,${Math.floor(Math.random()*80+140)},${Math.floor(Math.random()*60)},${bright});
      `;
      sl.appendChild(s);
    }
  }

  /* ── 2. Shooting stars ── */
  const sw = document.getElementById('shoot-wrap');
  if(sw){
    const shootCount = 8;
    for(let i=0;i<shootCount;i++){
      const s = document.createElement('div');
      s.className = 'shoot';
      const len = Math.random()*120+60;
      s.style.cssText = `
        left:${Math.random()*60}%;
        top:${Math.random()*50}%;
        width:${len}px;
        height:${Math.random()*1.5+.8}px;
        --sd:${(Math.random()*3+2).toFixed(1)}s;
        --sde:${(Math.random()*8).toFixed(1)}s;
      `;
      sw.appendChild(s);
    }
  }

  /* ── 3. Falling Keys ── */
  const fw = document.getElementById('falling-keys-wrap');
  if(fw){
    /* SVG for a tiny key */
    const keySVG = (color, size) => `
      <svg width="${size}" height="${size}" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="22" cy="22" r="14" stroke="${color}" stroke-width="5" fill="none"/>
        <circle cx="22" cy="22" r="5" fill="${color}" opacity=".4"/>
        <rect x="32" y="19" width="24" height="6" rx="3" fill="${color}"/>
        <rect x="42" y="25" width="5" height="7" rx="2" fill="${color}" opacity=".8"/>
        <rect x="50" y="25" width="5" height="5" rx="2" fill="${color}" opacity=".8"/>
      </svg>`;

    const keyColors = ['#ff6b00','#ff8c2e','#ffad5c','#ffd0a0','#ff4400','rgba(255,107,0,.7)'];
    const keyCount = 22;
    for(let i=0;i<keyCount;i++){
      const div = document.createElement('div');
      div.className = 'fkey';
      const size = Math.floor(Math.random()*18+10);
      const color = keyColors[Math.floor(Math.random()*keyColors.length)];
      const opacity = (Math.random()*.45+.15).toFixed(2);
      div.innerHTML = keySVG(color, size);
      div.style.cssText = `
        left:${Math.random()*100}%;
        --fkd:${(Math.random()*10+6).toFixed(1)}s;
        --fkde:${(Math.random()*12).toFixed(1)}s;
        --fkr:${Math.floor(Math.random()*360)}deg;
        --fko:${opacity};
      `;
      fw.appendChild(div);
    }
  }

  /* ── 4. Space dust ── */
  const dd = document.getElementById('space-dust');
  if(dd){
    for(let i=0;i<25;i++){
      const d = document.createElement('div');
      d.className = 'dust';
      const sz = Math.random()*2.5+.5;
      d.style.cssText = `
        width:${sz}px;height:${sz}px;
        left:${Math.random()*100}%;
        top:${Math.random()*100}%;
        --dd:${(Math.random()*10+8).toFixed(1)}s;
        --dde:${(Math.random()*8).toFixed(1)}s;
        opacity:0;
      `;
      dd.appendChild(d);
    }
  }
})();
</script>

<!-- ══ Key Cursor JS ══ -->
<script>
(function(){
  const k = document.getElementById('key-cursor');
  if(!k) return;
  let mx=0,my=0,kx=0,ky=0;
  document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY});
  function anim(){
    kx+=(mx-kx)*.18; ky+=(my-ky)*.18;
    k.style.left=kx+'px'; k.style.top=ky+'px';
    requestAnimationFrame(anim);
  }
  anim();
  const sel='a,button,input,select,.lang-card,.feat-card,.step-card,.plan-card,.km,.upzone,.gen-up-zone,.login-feat,.auth-tab,.icon-btn,.npill,.upill,.plan-btn,.act-btn,.btn-gold,.btn-outline-gold,.btn-ghost,.dc-btn,.local-btn,.footer-member,.footer-member-copy';
  document.addEventListener('mouseover',e=>{if(e.target.closest(sel)){k.classList.add('hov')}});
  document.addEventListener('mouseout',e=>{if(e.target.closest(sel)){k.classList.remove('hov')}});
  document.addEventListener('mousedown',()=>k.classList.add('clk'));
  document.addEventListener('mouseup',()=>k.classList.remove('clk'));
})();
</script>

<script src="/app.js"></script>
